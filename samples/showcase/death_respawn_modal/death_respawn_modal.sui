        "Source": {
          "Kind": "Manual"
        },
        "Description": "Big amber line above the buttons. Controller updates each OnUpdate tick: \"Respawn in Ns...\" while waiting or \"Ready!\" when done.",
        "IsAdvanced": false,
        "IsPublic": true,
        "Group": "Countdown",
        "ResourceType": null
      },
      {
